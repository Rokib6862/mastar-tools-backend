# ============================================================
# MEGA TOOLS — ENVIRONMENT VARIABLES TEMPLATE v4.0
# ============================================================
# Copy this file to .env for local development.
# For production, set these in Render/Heroku Dashboard.

# ---- SECURITY ----
JWT_SECRET=your_jwt_secret_change_here
WEBHOOK_SECRET_KEY=your_webhook_secret_change_here
OWNER_API_TOKEN=your_owner_token_change_here
BCRYPT_SALT_ROUNDS=12

# ---- SERVER ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- API (for generated external pages) ----
# API_BASE_URL=https://your-api.onrender.com

# ---- SESSION TIMINGS ----
SESSION_TIMEOUT_MS=180000
HEARTBEAT_INTERVAL_MS=5000
AWAY_THRESHOLD_MS=30000
INBOX_CLEAN_INTERVAL_MS=86400000
TRIAL_DURATION_MS=300000

# ---- RATE LIMITING ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# ---- LOGIN SECURITY ----
LOGIN_ATTEMPTS_MAX=5
LOGIN_ATTEMPTS_WINDOW_MS=900000
# ============================================================
# MEGA TOOLS — PRODUCTION ENVIRONMENT TEMPLATE
# ============================================================
# এই File-টি Production Deployment-এর জন্য Template।
# আসল .env File-এ Real Values দিন।
# .env.example কখনো Production-এ Deploy করবেন না।

# ---- DATABASE (MongoDB Atlas) ----
# MongoDB Atlas Dashboard: https://cloud.mongodb.com
# Database: megamastartools
# User: mega_master_tools_db_user
# Network Access: 0.0.0.0/0 (All IPs Allowed)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=megamastartools

# ---- SECURITY ----
# JWT Secret: কমপক্ষে 64-character random string
# Generate করুন: https://www.grc.com/passwords.htm
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
WEBHOOK_SECRET_KEY=REPLACE_WITH_WEBHOOK_SECRET
ADMIN_API_TOKEN=REPLACE_WITH_ADMIN_API_TOKEN
BCRYPT_SALT_ROUNDS=12

# ---- SERVER ----
PORT=5000
NODE_ENV=production
CLIENT_URL=https://mega-tools.online

# ---- RATE LIMITING ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# ---- SESSION TIMINGS (Production: 10min timeout, 30s heartbeat) ----
SESSION_TIMEOUT_MS=600000
HEARTBEAT_INTERVAL_MS=30000
AWAY_THRESHOLD_MS=120000
INBOX_CLEAN_INTERVAL_MS=86400000

# ---- LOGIN SECURITY ----
LOGIN_ATTEMPTS_MAX=5
LOGIN_ATTEMPTS_WINDOW_MS=900000

# ---- IMAGE UPLOAD (imgbb - Primary) ----
# imgbb Dashboard: https://imgbb.com/settings
# API Key Generate করুন
IMGBB_API_KEY_1=REPLACE_WITH_IMGBB_API_KEY_1
IMGBB_API_KEY_2=REPLACE_WITH_IMGBB_API_KEY_2_OPTIONAL

# ---- IMAGE UPLOAD (FreeImage.host - Backup) ----
# FreeImage Dashboard: https://freeimage.host/settings
FREEIMAGE_API_KEY=REPLACE_WITH_FREEIMAGE_API_KEY

# ---- EMAIL (Brevo/SendinBlue) ----
# Brevo Dashboard: https://app.brevo.com
# API Keys: Settings → API Keys
BREVO_API_KEY=REPLACE_WITH_BREVO_API_KEY
BREVO_SENDER_EMAIL=noreply@megatools.site
BREVO_SENDER_NAME=Mega Tools Support

# ---- OPTIONAL: imgbb Legacy Key ----
IMGBB_API_KEY=REPLACE_WITH_IMGBB_API_KEY
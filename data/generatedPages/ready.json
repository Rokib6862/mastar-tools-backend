  "code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n\n<style>\n*{\n    margin:0;\n    padding:0;\n    box-sizing:border-box;\n}\n\nhtml,\nbody{\n    width:100%;\n    height:100%;\n    overflow:hidden;\n    font-family:Arial,Helvetica,sans-serif;\n    background:#fff;\n}\n\nbody{\n    display:flex;\n    justify-content:center;\n    align-items:center;\n    padding:20px;\n}\n\n.container{\n    width:100%;\n    max-width:380px;\n}\n\n.step{\n    display:none;\n    flex-direction:column;\n    gap:16px;\n}\n\n.step:target{\n    display:flex;\n}\n\n#step1{\n    display:flex;\n}\n\nbody:has(#step2:target) #step1,\nbody:has(#step3:target) #step1{\n    display:none;\n}\n\nbody:has(#step3:target) #step2{\n    display:none;\n}\n\ninput{\n    width:100%;\n    height:52px;\n    padding:0 16px;\n    border:1px solid #ddd;\n    border-radius:10px;\n    font-size:16px;\n    outline:none;\n}\n\ninput:focus{\n    border-color:#111;\n}\n\na,\nbutton{\n    width:100%;\n    height:52px;\n    border:none;\n    border-radius:10px;\n    background:#111;\n    color:#fff;\n    text-decoration:none;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    font-size:16px;\n    font-weight:600;\n    cursor:pointer;\n}\n\n@media(max-width:480px){\n    body{\n        padding:16px;\n    }\n}\n</style>\n</head>\n<body>\n\n<div class=\"container\">\n\n    <form id=\"step1\" class=\"step\">\n        <input type=\"text\" name=\"fullname\" placeholder=\"Full Name\" required>\n        <a href=\"#step2\">Continue</a>\n    </form>\n\n    <form id=\"step2\" class=\"step\">\n        <input type=\"email\" name=\"email\" placeholder=\"Email\" required>\n        <a href=\"#step3\">Continue</a>\n    </form>\n\n    <form id=\"step3\" class=\"step\">\n        <input type=\"tel\" name=\"phone\" placeholder=\"Phone\" required>\n        <button type=\"submit\">Submit</button>\n    </form>\n\n</div>\n\n</body>\n</html>",
